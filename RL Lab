import random, numpy as np, torch
import torch.nn as nn, torch.optim as optim

class LineWorld:
    def reset(self): self.state=2; return self.state
    def step(self,a):
        self.state += -1 if a==0 else 1
        if self.state==4: return self.state,1.0,True
        if self.state==0: return self.state,0.0,True
        return self.state,0.0,False

def one_hot(s):
    x=np.zeros(5); x[s]=1
    return torch.tensor(x,dtype=torch.float32)

class DuelingDQN(nn.Module):
    def __init__(self):
        super().__init__()
        self.fc=nn.Linear(5,16)
        self.value=nn.Linear(16,1)
        self.adv=nn.Linear(16,2)
    def forward(self,x):
        x=torch.relu(self.fc(x))
        V=self.value(x)
        A=self.adv(x)
        return V+(A-A.mean())

env=LineWorld()
net,target=DuelingDQN(),DuelingDQN()
target.load_state_dict(net.state_dict())

opt=optim.Adam(net.parameters(),lr=0.01)
gamma=0.9

for ep in range(300):
    s=env.reset(); done=False
    while not done:
        a=torch.argmax(net(one_hot(s))).item()
        ns,r,done=env.step(a)

        q=net(one_hot(s))[a]
        with torch.no_grad():
            if done: y=torch.tensor(r)
            else:
                best=torch.argmax(net(one_hot(ns))).item()
                y=r+gamma*target(one_hot(ns))[best]

        loss=(y-q)**2
        opt.zero_grad(); loss.backward(); opt.step()
        s=ns

    if ep%20==0:
        target.load_state_dict(net.state_dict())

print("Dueling DDQN Training Completed\n")
for s in range(5):
    print("State",s,":",net(one_hot(s)).detach().numpy())
