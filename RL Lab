CODE
gamma = 0.9
grid_size = 3
terminal_state = 8

policy = {0:"R",1:"R",2:"D",3:"R",4:"R",5:"D",6:"R",7:"R"}

def get_next_state(state, action):
    row = state // grid_size
    col = state % grid_size
    if action == "R" and col < grid_size-1: col += 1
    elif action == "D" and row < grid_size-1: row += 1
    return row*grid_size + col

def compute_state_value(state):
    if state == terminal_state: return 0
    return -1 + gamma * compute_state_value(get_next_state(state, policy[state]))

state_values = {s: round(compute_state_value(s),2) for s in range(9)}
print(state_values)
