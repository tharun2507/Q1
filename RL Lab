CODE
import random, numpy as np, torch
import torch.nn as nn, torch.optim as optim

class LineWorld:
    def reset(self): self.state=2; return self.state
    def step(self,a):
        self.state += -1 if a==0 else 1
        if self.state==4: return self.state,1.0,True
        if self.state==0: return self.state,0.0,True
        return self.state,0.0,False

def one_hot(s):
    x=np.zeros(5); x[s]=1
    return torch.tensor(x,dtype=torch.float32)

class DQN(nn.Module):
    def __init__(self):
        super().__init__()
        self.fc1=nn.Linear(5,16)
        self.fc2=nn.Linear(16,2)
    def forward(self,x): return self.fc2(torch.relu(self.fc1(x)))

env=LineWorld()
q_net, target_net = DQN(), DQN()
target_net.load_state_dict(q_net.state_dict())

optimizer=optim.Adam(q_net.parameters(),lr=0.01)
buffer=[]
gamma,epsilon=0.9,0.2

for ep in range(300):
    s=env.reset(); done=False
    while not done:
        a = random.randint(0,1) if random.random()<epsilon else torch.argmax(q_net(one_hot(s))).item()
        ns,r,done=env.step(a)
        buffer.append((s,a,r,ns,done))
        s=ns
        
        if len(buffer)<16: continue
        batch=random.sample(buffer,16)
        loss=0
        
        for s,a,r,ns,d in batch:
            q_sa=q_net(one_hot(s))[a]
            with torch.no_grad():
                y = r if d else r + gamma*torch.max(target_net(one_hot(ns)))
            loss += (y-q_sa)**2
        
        loss/=16
        optimizer.zero_grad(); loss.backward(); optimizer.step()

print("\nDQN Training Completed\n")
print("Learned Q-values:")
for s in range(5):
    print("State",s,":",q_net(one_hot(s)).detach().numpy())
