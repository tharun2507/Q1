💻 SOURCE CODE (Simple & Runnable)
# ============================================================
# Information Retrieval using BERT
# ============================================================

from sentence_transformers import SentenceTransformer
from sklearn.metrics.pairwise import cosine_similarity
import numpy as np

# ------------------------------------------------------------
# 1. LOAD MODEL
# ------------------------------------------------------------
model = SentenceTransformer('all-MiniLM-L6-v2')

print("Model Loaded Successfully")

# ------------------------------------------------------------
# 2. DOCUMENTS
# ------------------------------------------------------------
documents = [
    "information retrieval extracts relevant documents",
    "machine learning improves search engines",
    "deep learning is part of artificial intelligence",
    "natural language processing analyzes text",
    "search engines use ranking algorithms"
]

# ------------------------------------------------------------
# 3. ENCODE DOCUMENTS
# ------------------------------------------------------------
doc_embeddings = model.encode(documents)

# ------------------------------------------------------------
# 4. RETRIEVAL FUNCTION
# ------------------------------------------------------------
def retrieve(query):
    query_embedding = model.encode([query])
    similarity = cosine_similarity(query_embedding, doc_embeddings)
    index = np.argmax(similarity)
    return documents[index]

# ------------------------------------------------------------
# 5. TEST QUERY
# ------------------------------------------------------------
query = "deep learning methods"
result = retrieve(query)

print("\nQuery:", query)
print("Most Relevant Document:", result)
📊 OUTPUT (Sample Output)
