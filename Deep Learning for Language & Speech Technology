<!-- =========================================================
     AI Chatbot using HTML + JavaScript
     ========================================================= -->

<!DOCTYPE html>
<html>
<head>
    <title>AI Chatbot</title>
</head>
<body>

<h2>AI Chatbot</h2>

<input type="text" id="inp" placeholder="Ask a question">
<button onclick="send()">Send</button>

<div id="chat"></div>

<script>

// ------------------------------------------------------------
// 1. KNOWLEDGE BASE
// ------------------------------------------------------------
const KB = [
{
 keys:['what is ai','artificial intelligence'],
 ans:'Artificial Intelligence is the ability of machines to simulate human intelligence.'
},
{
 keys:['what is machine learning'],
 ans:'Machine Learning allows systems to learn from data.'
},
{
 keys:['what is deep learning'],
 ans:'Deep Learning is a subset of machine learning using neural networks.'
}
];

// ------------------------------------------------------------
// 2. MATCH FUNCTION
// ------------------------------------------------------------
function match(query){
 query = query.toLowerCase();

 for(const entry of KB){
   for(const keyword of entry.keys){
     if(query.includes(keyword)){
       return entry;
     }
   }
 }
 return null;
}

// ------------------------------------------------------------
// 3. SEND FUNCTION
// ------------------------------------------------------------
function send(){
 const input = document.getElementById("inp").value;

 addMsg("You: " + input);

 const result = match(input);

 if(result){
   addMsg("Bot: " + result.ans);
 }else{
   addMsg("Bot: Sorry, I don't understand.");
 }
}

// ------------------------------------------------------------
// 4. DISPLAY MESSAGE
// ------------------------------------------------------------
function addMsg(text){
 const chat = document.getElementById("chat");
 const p = document.createElement("p");
 p.innerText = text;
 chat.appendChild(p);
}

</script>

</body>
</html>
