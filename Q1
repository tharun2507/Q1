# Ex5: K-MEANS, HIERARCHICAL, GMM (IRIS + WINE)
# =========================================================
def ex5_clustering():
    print("\n[Ex5 – CLUSTERING]")
    iris = load_iris()
    X_iris, y_iris = iris.data, iris.target

    # ---- K-Means (Iris) ----
    km = KMeans(n_clusters=3, random_state=42, n_init=10)
    labels_km = km.fit_predict(X_iris)
    plt.scatter(X_iris[:, 0], X_iris[:, 1], c=labels_km, cmap='viridis')
    plt.scatter(km.cluster_centers_[:, 0], km.cluster_centers_[:, 1],
                c='red', marker='X', s=200)
    plt.title("K-Means – Iris (first 2 features)")
    plt.show()

    # ---- Hierarchical Clustering (Iris) ----
    linked = linkage(X_iris, method='ward')
    plt.figure(figsize=(8, 4))
    dendrogram(linked)
    plt.title("Hierarchical Dendrogram – Iris")
    plt.show()

    hc = AgglomerativeClustering(n_clusters=3, linkage='ward')
    labels_hc = hc.fit_predict(X_iris)
    plt.scatter(X_iris[:, 0], X_iris[:, 1], c=labels_hc, cmap='viridis')
    plt.title("Agglomerative – Iris (first 2 features)")
    plt.show()

    # ---- GMM (Iris) ----
    scaler = StandardScaler()
    X_iris_s = scaler.fit_transform(X_iris)
    gmm = GaussianMixture(n_components=3, random_state=0)
    labels_gmm = gmm.fit_predict(X_iris_s)
    df_iris = pd.DataFrame(X_iris_s, columns=iris.feature_names)
    df_iris['Cluster'] = labels_gmm
    df_iris['True'] = y_iris
    sns.scatterplot(data=df_iris,
                    x='sepal length (cm)', y='sepal width (cm)',
                    hue='Cluster', style='True', palette='viridis')
    plt.title("GMM – Iris")
    plt.show()

    print("GMM Means:\n", gmm.means_)

    # ---- K-Means + Hierarchical (Wine) ----
    wine = load_wine()
    X_wine = wine.data

    km_w = KMeans(n_clusters=3, random_state=42, n_init=10)
    labels_wine = km_w.fit_predict(X_wine)
    plt.scatter(X_wine[:, 0], X_wine[:, 1], c=labels_wine, cmap='viridis')
    plt.title("K-Means – Wine (first 2 features)")
    plt.show()

    linked_w = linkage(X_wine, method='ward')
    plt.figure(figsize=(8, 4))
    dendrogram(linked_w)
    plt.title("Hierarchical Dendrogram – Wine")
    plt.show()

