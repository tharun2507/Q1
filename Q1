import heapq

def huffman(s):
    h = [[s.count(c), [c, ""]] for c in set(s)]
    heapq.heapify(h)

    while len(h) > 1:
        a, b = heapq.heappop(h), heapq.heappop(h)

        for x in a[1:]: x[1] = '0' + x[1]
        for x in b[1:]: x[1] = '1' + x[1]

        heapq.heappush(h, [a[0] + b[0]] + a[1:] + b[1:])

    return {c: code for c, code in h[0][1:]}

msg = input("Enter text: ")
cd = huffman(msg)

print("\nHuffman Codes:")
for c in sorted(cd):
    print(f"'{c}': {cd[c]}")

enc = ''.join(cd[c] for c in msg)
print("\nEncoded :", enc)
print("Original Bits  :", len(msg)*8)
print("Compressed Bits:", len(enc))
print("Ratio:", round((len(msg)*8)/len(enc), 2))


def lcs(a,b):
    m,n=len(a),len(b)
    dp=[[0]*(n+1) for _ in range(m+1)]
    for i in range(m):
        for j in range(n):
            dp[i+1][j+1]=dp[i][j]+1 if a[i]==b[j] else max(dp[i][j+1],dp[i+1][j])
    print("LCS Length:",dp[m][n])

