t1 = threading.Thread(target=lambda:[cht.insert(k,v) for k,v in [("a",1),("b",2)]])
t2 = threading.Thread(target=lambda:[cht.insert(k,v) for k,v in [("c",3),("d",4)]])
t1.start(); t2.start(); t1.join(); t2.join()
cht.show()


# ===================== 9. Cuckoo Hashing =====================
class CuckooHash:
    def __init__(self, size=7, maxloop=20):
        self.n = size
        self.max = maxloop
        self.t1 = [None]*size
        self.t2 = [None]*size

    def h1(self,k): return hash(k)%self.n
    def h2(self,k): return (hash(k)//self.n)%self.n

    def insert(self,k):
        c, l = k, 0
        while l < self.max:
            i = self.h1(c)
            if self.t1[i] is None:
                self.t1[i] = c; return
            c, self.t1[i] = self.t1[i], c

            j = self.h2(c)
            if self.t2[j] is None:
                self.t2[j] = c; return
            c, self.t2[j] = self.t2[j], c
            l += 1

    def show(self):
        print("\nCuckoo Hashing:")
        print("Table1:", self.t1)
        print("Table2:", self.t2)

ck = CuckooHash()
for k in ["apple","banana","cherry","date","fig","grape"]:
    ck.insert(k)
ck.show()
