import numpy as np

A = np.array([[2,1],[1,2]])  # or read runtime as above
B = np.array([[3,0],[0,1]])

C = A.dot(B)
print("C:\n", C)

# eigen decomposition
eigvals_A, eigvecs_A = np.linalg.eig(A)
eigvals_B, eigvecs_B = np.linalg.eig(B)

print("eigvals A:", eigvals_A)
print("eigvecs A:\n", eigvecs_A)

# addition between eigenvectors (flatten or column-wise)
# Example: sum of first eigenvectors (ensure same shapes)
sum_ev = eigvecs_A + eigvecs_B
print("sum of eigenvector matrices:\n", sum_ev)

# diagonal matrix of C (diagonal entries of C)
diagC = np.diag(np.diag(C))
print("Diagonal matrix of C:\n", diagC)

