# ===================== 1. Singly Linked List (Mutex Lock) =====================
class Node:
    def __init__(self, d, nxt=None):
        self.d, self.n = d, nxt

class MutexLL:
    def __init__(self):
        self.h = None
        self.l = threading.Lock()

    def insert(self, d):
        with self.l:
            self.h = Node(d, self.h)

    def show(self):
        print("\nMutex Linked List:", end=" ")
        c = self.h
        while c:
            print(c.d, end="->")
            c = c.n
        print("None")

