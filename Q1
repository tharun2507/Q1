# graph_centrality.py
import pandas as pd
import networkx as nx
import matplotlib.pyplot as plt

df = pd.read_csv('my_graph1.tsv', sep='\t', header=None, names=['u','v'])
G = nx.from_pandas_edgelist(df, 'u', 'v')

deg = nx.degree_centrality(G)
bet = nx.betweenness_centrality(G)
clo = nx.closeness_centrality(G)

print("Degree centrality:", deg)
print("Betweenness centrality:", bet)
print("Closeness centrality:", clo)

# shortest path between every pair
sp = dict(nx.all_pairs_shortest_path_length(G))
# print nicely
for u, d in sp.items():
    print(u, "->", d)

# draw
pos = nx.spring_layout(G)
plt.figure(figsize=(8,6))
nx.draw(G, pos, with_labels=True, node_size=500)
plt.title("Graph (spring layout)")
plt.show()

