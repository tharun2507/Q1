# ===================== 6. Lock-Free Stack with Backoff =====================
class LockFreeStack:
    def __init__(self):
        self.s = LifoQueue()

    def push(self, item):
        while True:
            try:
                self.s.put(item, block=False)
                break
            except:
                time.sleep(random.uniform(0.001, 0.01))

    def pop(self):
        while True:
            try:
                return self.s.get(block=False)
            except:
                time.sleep(random.uniform(0.001, 0.01))
                if self.s.empty(): return None

    def show(self):
        arr = list(self.s.queue)
        print("Lock-Free Stack:", "->".join(map(str, arr[::-1])), "->None")

stack = LockFreeStack()

t1 = threading.Thread(target=lambda:[stack.push(i) for i in [1,2,3,4,5]])
t2 = threading.Thread(target=lambda:[stack.pop() for _ in range(5)])
t3 = threading.Thread(target=lambda:[stack.push(i) for i in [6,7,8,9,10]])
t4 = threading.Thread(target=lambda:[stack.pop() for _ in range(5)])

for t in [t1,t2,t3,t4]: t.start()
for t in [t1,t2,t3,t4]: t.join()

stack.show()


# ===================== 7. Hash Table (Insert & Delete) =====================
class HashTable:
    def __init__(self, size=5):
        self.size = size
        self.tab = [[] for _ in range(size)]

    def hash(self, k): return hash(k)%self.size

    def insert(self, k, v):
        i = self.hash(k)
        for p in self.tab[i]:
            if p[0] == k:
                p[1] = v
                return
        self.tab[i].append([k,v])

    def delete(self, k):
        i = self.hash(k)
        for j,p in enumerate(self.tab[i]):
            if p[0] == k:
                del self.tab[i][j]
                return True
        return False

    def search(self, k):
        i = self.hash(k)
        for p in self.tab[i]:
            if p[0] == k:
                return p[1]
        return None

    def show(self):
        print("\nHash Table:")
        for i,b in enumerate(self.tab):
            print(i, ":", b)

