Question IV 
You have a dataset containing information about customers of a subscription service, 
including their demographics, usage patterns, and whether they churned (cancelled their 
subscription) in the last month. Build a logistic regression model to predict the probability of 
customer churn based on the available features. Identify the key features that have the 
most significant impact on churn probability based on the model's coefficients. 
import pandas as pd 
from sklearn.model_selection import train_test_split 
from sklearn.preprocessing import StandardScaler 
from sklearn.linear_model import LogisticRegression 
from sklearn.metrics import accuracy_score 
df = pd.read_csv("customer_churn.csv") 
y = df['Churn'] 
X = df.drop('Churn', axis=1) 
X = pd.get_dummies(X, drop_first=True) 
X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.3, random_state=42) 
model = LogisticRegression(max_iter=200) 
model.fit(X_train, y_train) 
pred = model.predict(X_test) 
print("Accuracy:", accuracy_score(y_test, pred)) 
coeff = pd.DataFrame({'Feature': X.columns, 'Coefficient': model.coef_[0]}) 
print(coeff.sort_values(by='Coefficient', ascending=False))  
