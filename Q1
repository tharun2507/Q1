# ===================== 7. Hash Table (Insert & Delete) =====================
class HashTable:
    def __init__(self, size=5):
        self.size = size
        self.tab = [[] for _ in range(size)]

    def hash(self, k): return hash(k)%self.size

    def insert(self, k, v):
        i = self.hash(k)
        for p in self.tab[i]:
            if p[0] == k:
                p[1] = v
                return
        self.tab[i].append([k,v])

    def delete(self, k):
        i = self.hash(k)
        for j,p in enumerate(self.tab[i]):
            if p[0] == k:
                del self.tab[i][j]
                return True
        return False

    def search(self, k):
        i = self.hash(k)
        for p in self.tab[i]:
            if p[0] == k:
                return p[1]
        return None

    def show(self):
        print("\nHash Table:")
        for i,b in enumerate(self.tab):
            print(i, ":", b)

