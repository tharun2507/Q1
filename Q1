# ----------------- 2. Fine-Grained Locking Linked List -----------------
class NFG:
    def __init__(s,d,n=None): s.d=d; s.n=n; s.l=threading.Lock()

class FGL:
    def __init__(s): s.h=NFG(None)
    def insert(s,d):
        nn=NFG(d); p=s.h; p.l.acquire()
        c=p.n
        if c: c.l.acquire()
        nn.n=c; p.n=nn
        if c: c.l.release()
        p.l.release()
    def show(s):
        print("Fine-Grain LL:", end=" ")
        c=s.h.n
        while c: print(c.d,end="->"); c=c.n
        print("None")

