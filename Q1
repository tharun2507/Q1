            np.sum(y[i:i+frame_length] ** 2)
            for i in range(0, len(y) - frame_length, hop_length)
        ])
        zcr = librosa.feature.zero_crossing_rate(
            y=y, frame_length=frame_length, hop_length=hop_length
        )[0]
        voiced = (energy > 0.01) & (zcr < 0.1)

