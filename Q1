import pandas as pd
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler
from sklearn.svm import SVC
from sklearn.metrics import accuracy_score, classification_report

# Example dataset
data = {
    'Amount':[100,20000,50,15000,30,1000,25000,70],
    'TransactionTime':[12,3,14,2,11,8,4,15],
    'Feature1':[0.1,0.9,0.3,0.8,0.2,0.5,0.95,0.25],
    'Feature2':[0.2,0.8,0.4,0.85,0.3,0.55,0.99,0.35],
    'Class':[0,1,0,1,0,0,1,0]   # 1 = Fraud
}

df = pd.DataFrame(data)

# Split
X = df.drop(columns=['Class'])
y = df['Class']

X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.25, random_state=42
)

# Scaling
scaler = StandardScaler()
X_train = scaler.fit_transform(X_train)
X_test = scaler.transform(X_test)

# SVM Model
svm = SVC(kernel='rbf', class_weight='balanced')
svm.fit(X_train, y_train)

# Predictions
y_pred = svm.predict(X_test)

print("Accuracy:", accuracy_score(y_test, y_pred))
print("\nClassification Report:\n", classification_report(y_test, y_pred))
print("Predicted:", list(y_pred))
