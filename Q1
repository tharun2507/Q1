# numpy_ops_runtime.py
import numpy as np

def read_matrix(prompt):
    print(prompt)
    rows = int(input("Number of rows: "))
    cols = int(input("Number of cols: "))
    print("Enter rows, space separated values:")
    mat = []
    for r in range(rows):
        row = list(map(float, input().strip().split()))
        if len(row) != cols:
            raise ValueError("Wrong number of columns")
        mat.append(row)
    return np.array(mat)

A = read_matrix("Matrix A")
B = read_matrix("Matrix B")

C = A.dot(B)
D = A + B  # shapes must match

print("C =\n", C)
print("D =\n", D)

from numpy.linalg import det
print("det(C) =", det(C))
print("det(D) =", det(D))

print("C.T =\n", C.T)
print("D.T =\n", D.T)

