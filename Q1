import pandas as pd
from sklearn.model_selection import train_test_split
from sklearn.compose import ColumnTransformer
from sklearn.preprocessing import OneHotEncoder, StandardScaler
from sklearn.linear_model import LinearRegression
from sklearn.metrics import mean_squared_error, r2_score
import numpy as np

data = {
    'age':[25,32,47,51,62,28,36,44],
    'sex':['male','female','female','male','male','female','female','male'],
    'bmi':[22.4,27.8,30.2,25.3,31.1,23.5,28.2,29.4],
    'children':[0,1,2,1,3,0,2,1],
    'smoker':['no','no','yes','yes','yes','no','no','yes'],
    'region':['southwest','southeast','northwest','northeast','southwest','southeast','northwest','northeast'],
    'charges':[2500,3200,41000,38000,42000,2600,3500,39000]
}

df = pd.DataFrame(data)

X = df.drop(columns=['charges'])
y = df['charges']

cat_cols = ['sex', 'smoker', 'region']
num_cols = ['age', 'bmi', 'children']

preprocess = ColumnTransformer([
    ('num', StandardScaler(), num_cols),
    ('cat', OneHotEncoder(drop='first', handle_unknown='ignore'), cat_cols)
])

X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.25, random_state=42
)

X_train_trans = preprocess.fit_transform(X_train)
X_test_trans = preprocess.transform(X_test)

model = LinearRegression()
model.fit(X_train_trans, y_train)
y_pred = model.predict(X_test_trans)

print("Predicted charges:", y_pred)
print("RMSE:", np.sqrt(mean_squared_error(y_test, y_pred)))
print("R² Score:", r2_score(y_test, y_pred))
