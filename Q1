# ----------- NORMAL QUICK SORT -----------
def quick_sort(arr):
    if len(arr) <= 1:
        return arr

    pivot = arr[-1]       # choose last element as pivot
    left = []             # items <= pivot
    right = []            # items > pivot

    for x in arr[:-1]:
        if x <= pivot:
            left.append(x)
        else:
            right.append(x)

    return quick_sort(left) + [pivot] + quick_sort(right)


# ----------- RANDOMIZED QUICK SORT -----------
def randomized_quick_sort(arr):
    if len(arr) <= 1:
        return arr

    pivot = random.choice(arr)   # random pivot
    left = []
    mid = []
    right = []

    for x in arr:
        if x < pivot:
            left.append(x)
        elif x == pivot:
            mid.append(x)
        else:
            right.append(x)

    return randomized_quick_sort(left) + mid + randomized_quick_sort(right)


