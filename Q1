import math

def tsp(cities):
    n = len(cities)
    visited = [False] * n
    path = [0]
    visited[0] = True
    total = 0

    for _ in range(n - 1):
        last = path[-1]
        nearest = min(
            (i for i in range(n) if not visited[i]),
            key=lambda i: math.dist(cities[last], cities[i])
        )
        total += math.dist(cities[last], cities[nearest])
        path.append(nearest)
        visited[nearest] = True

    total += math.dist(cities[path[-1]], cities[0])
    path.append(0)
    return path, total

cities = [(0,0), (2,3), (5,2), (6,6)]
p, t = tsp(cities)
print("Path:", p)
print("Total Distance:", round(t, 2))

import random, time

# ----------- NORMAL QUICK SORT -----------
def quick_sort(arr):
    if len(arr) <= 1:
        return arr

    pivot = arr[-1]       # choose last element as pivot
    left = []             # items <= pivot
    right = []            # items > pivot

    for x in arr[:-1]:
        if x <= pivot:
            left.append(x)
        else:
            right.append(x)

    return quick_sort(left) + [pivot] + quick_sort(right)


# ----------- RANDOMIZED QUICK SORT -----------
def randomized_quick_sort(arr):
    if len(arr) <= 1:
        return arr

    pivot = random.choice(arr)   # random pivot
    left = []
    mid = []
    right = []

    for x in arr:
        if x < pivot:
            left.append(x)
        elif x == pivot:
            mid.append(x)
        else:
            right.append(x)

    return randomized_quick_sort(left) + mid + randomized_quick_sort(right)


# ----------- PERFORMANCE COMPARISON -----------
data = [random.randint(1, 10000) for _ in range(1000)]

start = time.time()
quick_sort(data)
print("Normal Quick Sort Time     :", round(time.time() - start, 5), "sec")

start = time.time()
randomized_quick_sort(data)
print("Randomized Quick Sort Time :", round(time.time() - start, 5), "sec")

print("\nNormal Quick Sort:     Avg O(n log n), Worst O(n²)")
