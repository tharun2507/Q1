# ===================== 8. Concurrent Hash Table =====================
class ConHash:
    def __init__(self, size=5):
        self.size = size
        self.tab = [[] for _ in range(size)]
        self.locks = [threading.Lock() for _ in range(size)]

    def hash(self, k): return hash(k)%self.size

    def insert(self, k, v):
        i = self.hash(k)
        with self.locks[i]:
            for p in self.tab[i]:
                if p[0] == k:
                    p[1] = v
                    return
            self.tab[i].append([k,v])

    def show(self):
        print("\nConcurrent Hash Table:")
        for i,b in enumerate(self.tab):
            print(i,":",b)

