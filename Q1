# ===================== 2. Fine-Grained Locking Linked List =====================
class FGNode:
    def __init__(self, d, nxt=None):
        self.d, self.n = d, nxt
        self.l = threading.Lock()

class FineLL:
    def __init__(self):
        self.h = FGNode(None)  # dummy head

    def insert(self, d):
        new = FGNode(d)
        p = self.h
        p.l.acquire()
        c = p.n
        if c: c.l.acquire()
        new.n = c
        p.n = new
        if c: c.l.release()
        p.l.release()

    def show(self):
        print("Fine-Grained LL:", end=" ")
        c = self.h.n
        while c:
            print(c.d, end="->")
            c = c.n
        print("None")

