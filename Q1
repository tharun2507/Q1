# grid_heart.py
import pandas as pd
from sklearn.model_selection import train_test_split, GridSearchCV
from sklearn.preprocessing import StandardScaler
from sklearn.svm import SVC
from sklearn.linear_model import LogisticRegression
from sklearn.pipeline import Pipeline
from sklearn.metrics import classification_report, roc_auc_score

df = pd.read_csv('heart.csv')
X = df.drop('target', axis=1); y = df['target']
X_train, X_test, y_train, y_test = train_test_split(X,y,stratify=y,test_size=0.2,random_state=42)

# SVM pipeline + Grid
pipe_svm = Pipeline([('scaler', StandardScaler()), ('clf', SVC(probability=True))])
param_grid_svm = {
  'clf__kernel': ['rbf','linear'],
  'clf__C': [0.1,1,10],
  'clf__gamma': ['scale','auto']
}
gs_svm = GridSearchCV(pipe_svm, param_grid_svm, cv=5, scoring='roc_auc', n_jobs=-1)
gs_svm.fit(X_train, y_train)
print("Best SVM:", gs_svm.best_params_, "score:", gs_svm.best_score_)

# Logistic pipeline + Grid
pipe_lr = Pipeline([('scaler', StandardScaler()), ('clf', LogisticRegression(max_iter=2000))])
param_grid_lr = {
  'clf__C': [0.01,0.1,1,10],
  'clf__penalty': ['l2']
}
gs_lr = GridSearchCV(pipe_lr, param_grid_lr, cv=5, scoring='roc_auc', n_jobs=-1)
gs_lr.fit(X_train, y_train)
print("Best LR:", gs_lr.best_params_, "score:", gs_lr.best_score_)

# Evaluate best models on test
for name, model in [('SVM', gs_svm.best_estimator_), ('LR', gs_lr.best_estimator_)]:
    y_pred = model.predict(X_test)
    y_proba = model.predict_proba(X_test)[:,1]
    print("===", name, "===")
    print(classification_report(y_test, y_pred))
    print("ROC AUC:", roc_auc_score(y_test, y_proba))

