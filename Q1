# ===================== 3. Lock-Free Linked List (Queue-Based) =====================
class LockFreeLL:
    def __init__(self):
        self.q = SimpleQueue()

    def insert(self, d):
        self.q.put(d)

    def show(self):
        temp = []
        while not self.q.empty():
            temp.append(self.q.get())
        for v in temp: self.q.put(v)
        print("Lock-Free LL:", "->".join(map(str, temp)), "->None")

