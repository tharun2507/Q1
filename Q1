# Graph Coloring
class GraphColoring:
    def __init__(self, graph):
        self.graph = graph
        self.V = len(graph)
        self.colors = [0] * self.V

    def is_safe(self, v, c):
        for i in range(self.V):
            if self.graph[v][i] == 1 and self.colors[i] == c:
                return False
        return True

    def solve_util(self, m, v=0):
        if v == self.V:
            return True
        for c in range(1, m+1):
            if self.is_safe(v, c):
                self.colors[v] = c
                if self.solve_util(m, v+1):
                    return True
                self.colors[v] = 0
        return False

    def solve(self, m):
        if self.solve_util(m):
            print("Solution:", self.colors)
        else:
            print("No solution")

