# ==========================================
# Information Retrieval using BERT
# ==========================================

from sentence_transformers import SentenceTransformer
from sklearn.metrics.pairwise import cosine_similarity
import numpy as np

# Load Pretrained BERT Model
model = SentenceTransformer('all-MiniLM-L6-v2')

documents = [
    "information retrieval extracts relevant documents",
    "machine learning improves search engines",
    "deep learning is part of artificial intelligence",
    "natural language processing analyzes text",
    "search engines use ranking algorithms"
]

# Encode Documents
doc_embeddings = model.encode(documents)

# Retrieval Function
def retrieve(query):
    query_embedding = model.encode([query])
    similarities = cosine_similarity(query_embedding, doc_embeddings)
    best_index = np.argmax(similarities)
    return documents[best_index]

print("\nQuery Result:")
print(retrieve("deep learning methods"))
