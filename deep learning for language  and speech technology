# ==========================================
# Named Entity Recognition using BERT
# Auto Install Version (Error Free)
# ==========================================

import subprocess
import sys

# Install transformers if not installed
try:
    from transformers import pipeline
except ModuleNotFoundError:
    subprocess.check_call([sys.executable, "-m", "pip", "install", "transformers"])
    from transformers import pipeline

# Install torch if not installed
try:
    import torch
except ModuleNotFoundError:
    subprocess.check_call([sys.executable, "-m", "pip", "install", "torch"])
    import torch

# -------------------------------
# Load Pretrained BERT NER Model
# -------------------------------

ner = pipeline("ner", model="dslim/bert-base-NER", aggregation_strategy="simple")

# -------------------------------
# Dataset
# -------------------------------

train_data = [
    "Sundar Pichai is the CEO of Google",
    "Satya Nadella works at Microsoft"
]

validation_data = [
    "Elon Musk founded SpaceX"
]

test_data = [
    "I live in India",
    "Google Translate is useful"
]

# -------------------------------
# Function to Run NER
# -------------------------------

def run_ner(dataset, name):
    print(f"\n{name} Results:")
    for text in dataset:
        print(f"\nSentence: {text}")
        entities = ner(text)
        for ent in entities:
            print(ent["word"], "->", ent["entity_group"])

# -------------------------------
# Run NER
# -------------------------------

run_ner(train_data, "Train Data")
run_ner(validation_data, "Validation Data")
run_ner(test_data, "Test Data")

